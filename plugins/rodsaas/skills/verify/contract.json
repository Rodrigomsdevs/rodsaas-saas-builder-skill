{
  "version": 1,
  "routes": [
    "/entrar", "/cadastro", "/esqueci-senha", "/redefinir-senha", "/verificar-email", "/convite",
    "/inicio", "/sem-empresa", "/configuracoes/empresa", "/configuracoes/membros", "/configuracoes/plano", "/perfil"
  ],
  "testids": {
    "auth": [
      "login-email", "login-password", "login-submit", "login-error",
      "signup-name", "signup-email", "signup-password", "signup-org-name", "signup-submit",
      "forgot-email", "forgot-submit", "forgot-success",
      "reset-password", "reset-submit", "reset-success",
      "verify-email-success",
      "invite-org-name", "invite-create-account", "invite-login", "invite-accept"
    ],
    "casca": [
      "app-shell", "sidebar", "sidebar-toggle",
      "org-switcher", "org-switcher-current", "org-switcher-item", "org-switcher-create",
      "create-org-name", "create-org-submit",
      "user-menu", "user-menu-logout", "theme-toggle"
    ],
    "estados": [
      "page-not-found", "error-state", "error-retry", "error-request-id",
      "empty-state", "empty-state-action", "skeleton", "forbidden-state", "confirm-dialog", "confirm-dialog-confirm"
    ],
    "empresa": ["org-settings-name", "org-settings-save"],
    "membros": [
      "members-table", "member-row", "member-role-select", "member-remove",
      "role-option-ADMIN", "role-option-MEMBER",
      "invite-button", "invite-email", "invite-role", "invite-submit", "invitation-row"
    ],
    "plano": ["plan-card", "plan-current", "usage-bar"]
  },
  "optionalTestids": {
    "modulo-exemplo": {
      "when": "GET /v1/projects existe",
      "ids": [
        "page-header-action", "data-table-row", "row-actions", "row-action-edit", "row-action-delete",
        "form-sheet", "form-submit", "search-input", "field-*", "field-error-*", "upgrade-dialog"
      ]
    }
  },
  "api": [
    { "method": "get", "path": "/health" },
    { "method": "post", "path": "/v1/auth/register", "body": ["name", "email", "password", "organizationName", "invitationToken"] },
    { "method": "post", "path": "/v1/auth/login", "body": ["email", "password"] },
    { "method": "post", "path": "/v1/auth/refresh" },
    { "method": "post", "path": "/v1/auth/logout" },
    { "method": "post", "path": "/v1/auth/forgot-password", "body": ["email"] },
    { "method": "post", "path": "/v1/auth/reset-password" },
    { "method": "post", "path": "/v1/auth/verify-email" },
    { "method": "post", "path": "/v1/auth/switch-organization", "body": ["organizationId"] },
    { "method": "get", "path": "/v1/me" },
    { "method": "post", "path": "/v1/organizations", "body": ["name"] },
    { "method": "get", "path": "/v1/members" },
    { "method": "patch", "path": "/v1/members/{id}", "body": ["role"] },
    { "method": "post", "path": "/v1/members/leave" },
    { "method": "post", "path": "/v1/invitations", "body": ["email", "role"] },
    { "method": "get", "path": "/v1/billing/plans" }
  ]
}
