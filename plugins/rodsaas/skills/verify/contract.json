{
  "version": 4,
  "routes": [
    "/entrar",
    "/cadastro",
    "/esqueci-senha",
    "/redefinir-senha",
    "/verificar-email",
    "/convite",
    "/inicio",
    "/sem-empresa",
    "/configuracoes/empresa",
    "/configuracoes/membros",
    "/configuracoes/plano",
    "/perfil",
    "/configuracoes/apps"
  ],
  "testids": {
    "auth": [
      "login-email",
      "login-password",
      "login-submit",
      "login-error",
      "signup-name",
      "signup-email",
      "signup-password",
      "signup-org-name",
      "signup-submit",
      "forgot-email",
      "forgot-submit",
      "forgot-success",
      "reset-password",
      "reset-submit",
      "reset-success",
      "verify-email-success",
      "invite-org-name",
      "invite-create-account",
      "invite-login",
      "invite-accept"
    ],
    "casca": [
      "app-shell",
      "sidebar",
      "sidebar-toggle",
      "org-switcher",
      "org-switcher-current",
      "org-switcher-item",
      "org-switcher-create",
      "create-org-name",
      "create-org-submit",
      "user-menu",
      "user-menu-logout",
      "theme-toggle"
    ],
    "estados": [
      "page-not-found",
      "error-state",
      "error-retry",
      "error-request-id",
      "empty-state",
      "empty-state-action",
      "skeleton",
      "forbidden-state",
      "confirm-dialog",
      "confirm-dialog-confirm"
    ],
    "empresa": [
      "org-settings-name",
      "org-settings-save"
    ],
    "membros": [
      "members-table",
      "member-row",
      "member-role-select",
      "member-remove",
      "role-option-ADMIN",
      "role-option-MEMBER",
      "invite-button",
      "invite-email",
      "invite-role",
      "invite-submit",
      "invitation-row"
    ],
    "plano": [
      "plan-card",
      "plan-current",
      "plan-subscribe",
      "usage-bar",
      "billing-mode-banner",
      "plan-change-dialog",
      "plan-change-confirm",
      "billing-cancel",
      "billing-resume",
      "billing-owner-only"
    ],
    "apps": [
      "app-rail",
      "app-rail-item",
      "app-launcher-open",
      "app-launcher",
      "app-launcher-search",
      "app-launcher-item",
      "app-pin",
      "sidebar-collapse",
      "sidebar-expand",
      "app-flyout",
      "app-tabbar",
      "app-tabbar-item",
      "app-toggle"
    ]
  },
  "optionalTestids": {
    "modulo-exemplo": {
      "when": "GET /v1/projects existe",
      "ids": [
        "page-header-action",
        "data-table-row",
        "row-actions",
        "row-action-edit",
        "row-action-delete",
        "form-sheet",
        "form-submit",
        "search-input",
        "field-*",
        "field-error-*",
        "upgrade-dialog"
      ],
      "level": "error"
    },
    "cobranca-stripe": {
      "when": "recomendado (modo stripe e preço anual)",
      "level": "warn",
      "ids": [
        "billing-portal",
        "billing-pending",
        "billing-cycle-toggle"
      ]
    }
  },
  "api": [
    {
      "method": "get",
      "path": "/health"
    },
    {
      "method": "post",
      "path": "/v1/auth/register",
      "body": [
        "name",
        "email",
        "password",
        "organizationName",
        "invitationToken"
      ]
    },
    {
      "method": "post",
      "path": "/v1/auth/login",
      "body": [
        "email",
        "password"
      ]
    },
    {
      "method": "post",
      "path": "/v1/auth/refresh"
    },
    {
      "method": "post",
      "path": "/v1/auth/logout"
    },
    {
      "method": "post",
      "path": "/v1/auth/forgot-password",
      "body": [
        "email"
      ]
    },
    {
      "method": "post",
      "path": "/v1/auth/reset-password"
    },
    {
      "method": "post",
      "path": "/v1/auth/verify-email"
    },
    {
      "method": "post",
      "path": "/v1/auth/switch-organization",
      "body": [
        "organizationId"
      ]
    },
    {
      "method": "get",
      "path": "/v1/me"
    },
    {
      "method": "put",
      "path": "/v1/me/preferences",
      "body": [
        "pinnedApps"
      ]
    },
    {
      "method": "post",
      "path": "/v1/organizations",
      "body": [
        "name"
      ]
    },
    {
      "method": "patch",
      "path": "/v1/organizations/current",
      "body": [
        "disabledApps"
      ]
    },
    {
      "method": "get",
      "path": "/v1/members"
    },
    {
      "method": "patch",
      "path": "/v1/members/{id}",
      "body": [
        "role"
      ]
    },
    {
      "method": "post",
      "path": "/v1/members/leave"
    },
    {
      "method": "post",
      "path": "/v1/invitations",
      "body": [
        "email",
        "role"
      ]
    },
    {
      "method": "get",
      "path": "/v1/billing/plans"
    },
    {
      "method": "get",
      "path": "/v1/billing/subscription"
    },
    {
      "method": "post",
      "path": "/v1/billing/checkout-sessions",
      "body": [
        "plan",
        "interval"
      ]
    },
    {
      "method": "get",
      "path": "/v1/billing/change-plan/preview"
    },
    {
      "method": "post",
      "path": "/v1/billing/change-plan",
      "body": [
        "plan",
        "interval"
      ]
    },
    {
      "method": "post",
      "path": "/v1/billing/cancel"
    },
    {
      "method": "post",
      "path": "/v1/billing/resume"
    },
    {
      "method": "post",
      "path": "/v1/billing/portal-sessions"
    }
  ],
  "presets": {
    "crm": {
      "when": "rodsaas.json → presets inclui \"crm\"",
      "routes": [
        "/crm/negocios",
        "/crm/negocios/[id]",
        "/crm/leads",
        "/crm/contatos",
        "/crm/contatos/[id]",
        "/crm/empresas",
        "/crm/empresas/[id]",
        "/crm/atividades",
        "/crm/produtos",
        "/crm/relatorios",
        "/crm/importar",
        "/crm/configuracoes"
      ],
      "testids": [
        "crm-pipeline-select",
        "crm-board",
        "crm-stage-column",
        "crm-stage-total",
        "crm-deal-card",
        "crm-next-activity",
        "crm-deal-new",
        "crm-deal-title",
        "crm-deal-status",
        "crm-stage-step",
        "crm-deal-won",
        "crm-deal-lost",
        "crm-deal-reopen",
        "crm-lost-dialog",
        "crm-lost-reason",
        "crm-lost-reason-option",
        "crm-lost-confirm",
        "crm-activity-new",
        "crm-activity-row",
        "crm-activity-done",
        "crm-activities-tab-overdue",
        "crm-activities-tab-today",
        "crm-activities-tab-upcoming",
        "crm-note-input",
        "crm-note-submit",
        "crm-timeline",
        "crm-timeline-item",
        "crm-contact-new",
        "crm-company-new",
        "crm-duplicate-warning",
        "crm-duplicate-open",
        "crm-lead-row",
        "crm-lead-convert",
        "crm-convert-dialog",
        "crm-convert-confirm",
        "field-title",
        "field-error-title",
        "field-value",
        "field-subject",
        "field-email"
      ],
      "api": [
        {
          "method": "get",
          "path": "/v1/crm/settings"
        },
        {
          "method": "patch",
          "path": "/v1/crm/settings",
          "body": [
            "visibility",
            "requireLostReason"
          ]
        },
        {
          "method": "get",
          "path": "/v1/crm/pipelines"
        },
        {
          "method": "get",
          "path": "/v1/crm/pipelines/{id}/board"
        },
        {
          "method": "get",
          "path": "/v1/crm/deals"
        },
        {
          "method": "post",
          "path": "/v1/crm/deals",
          "body": [
            "title",
            "value",
            "pipelineId",
            "stageId",
            "contactId",
            "companyId"
          ]
        },
        {
          "method": "get",
          "path": "/v1/crm/deals/{id}"
        },
        {
          "method": "patch",
          "path": "/v1/crm/deals/{id}"
        },
        {
          "method": "post",
          "path": "/v1/crm/deals/{id}/move",
          "body": [
            "stageId"
          ]
        },
        {
          "method": "post",
          "path": "/v1/crm/deals/{id}/won"
        },
        {
          "method": "post",
          "path": "/v1/crm/deals/{id}/lost",
          "body": [
            "lostReasonId"
          ]
        },
        {
          "method": "post",
          "path": "/v1/crm/deals/{id}/reopen"
        },
        {
          "method": "get",
          "path": "/v1/crm/lost-reasons"
        },
        {
          "method": "get",
          "path": "/v1/crm/contacts"
        },
        {
          "method": "post",
          "path": "/v1/crm/contacts",
          "body": [
            "name",
            "email",
            "phone"
          ]
        },
        {
          "method": "get",
          "path": "/v1/crm/leads"
        },
        {
          "method": "post",
          "path": "/v1/crm/leads",
          "body": [
            "personName",
            "email"
          ]
        },
        {
          "method": "get",
          "path": "/v1/crm/leads/{id}"
        },
        {
          "method": "post",
          "path": "/v1/crm/leads/{id}/convert"
        },
        {
          "method": "get",
          "path": "/v1/crm/activities"
        },
        {
          "method": "post",
          "path": "/v1/crm/activities",
          "body": [
            "type",
            "subject",
            "dueDate",
            "ownerId",
            "dealId"
          ]
        },
        {
          "method": "post",
          "path": "/v1/crm/activities/{id}/complete"
        },
        {
          "method": "post",
          "path": "/v1/crm/capture-keys",
          "body": [
            "name",
            "kind"
          ]
        },
        {
          "method": "delete",
          "path": "/v1/crm/capture-keys/{id}"
        },
        {
          "method": "post",
          "path": "/v1/public/crm/leads"
        }
      ]
    }
  }
}
