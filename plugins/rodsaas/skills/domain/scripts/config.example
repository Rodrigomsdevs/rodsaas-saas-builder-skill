# Configuração do domain.sh

PROJECT=agendafacil                      # slug do projeto (nome do arquivo no nginx e do certificado)
WEB_DOMAIN=app.agendafacil.com.br        # frontend (sem http://)
API_DOMAIN=api.agendafacil.com.br        # API — precisa ser do MESMO domínio do frontend (cookies de login)
WEB_PORT=3000                            # ports.web do rodsaas.json
API_PORT=3333                            # ports.api do rodsaas.json
LE_EMAIL=voce@agendafacil.com.br         # Let's Encrypt avisa vencimentos aqui

# Arquivos atualizados pelo comando env (relativos ao diretório atual)
API_ENV_FILE=api/.env
WEB_ENV_FILE=web/.env.production
RODSAAS_JSON=rodsaas.json

# FORCE=true                             # regerar o nginx mesmo já tendo HTTPS do certbot
